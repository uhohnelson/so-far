[Unit]
Description=Sofar Telegram bot
Documentation=https://github.com/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__APPDIR__
EnvironmentFile=__APPDIR__/.env
ExecStart=__APPDIR__/.venv/bin/python -m bot.main
Restart=always
RestartSec=5

# Keep the bot from starving a 1 GB VPS
MemoryMax=350M
MemoryHigh=250M

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# App lives under /home; allow the checkout (data/, optional .pyc) while
# ProtectSystem=strict keeps the rest of the filesystem read-only.
ReadWritePaths=__APPDIR__

[Install]
WantedBy=multi-user.target
