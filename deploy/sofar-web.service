[Unit]
Description=Sofar web app and API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__APPDIR__
EnvironmentFile=__APPDIR__/.env
ExecStart=__APPDIR__/.venv/bin/uvicorn server.api:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

MemoryMax=350M
MemoryHigh=250M

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# ProtectHome=true hides /home and breaks ExecStart for apps under ~/ (systemd 249).
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=__APPDIR__

[Install]
WantedBy=multi-user.target
