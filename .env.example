TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TMDB_API_KEY=your-tmdb-api-key
DATABASE_URL=sqlite:///./data/sofar.db
DEFAULT_TIMEZONE=America/New_York
# Episode alert poll interval in seconds (bot job queue; default 3600).
ALERT_CHECK_INTERVAL_SEC=3600
# Public URL of the web app - the bot includes it with /app login codes.
WEB_APP_URL=
# Set to 1 to enable FastAPI /docs /redoc /openapi.json (off in production).
SOFAR_DEBUG=0
